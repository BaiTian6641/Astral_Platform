# eth_rv_core RVFI trace/commit-contract formal proof (SymbiYosys).
#
# Proves the trace discipline of the eth_rv RV64IMC core — the first-class RVFI
# commit port the DiffTest verifies against Spike (C14 §4/§5, §8 checkpoint 6).
# The properties live under `ifdef FORMAL` in ethereal-shell/rtl/eth_rv/eth_rv_core.sv:
#
#   P1  a record (rvfi_valid_o) exists only for an instruction that left MEM
#       legally: not stalled on the D port (mem_wait), not trapped (mem_trap);
#   P2  the record's payload IS that MEM instruction (pc/insn), so a squashed
#       (flushed or never-executed) instruction can never appear in the trace;
#   P3  retirement chain: a flush empties the ID/EX and IF/ID slots of its
#       cycle, a trap empties MEM, a stalled D port freezes the MEM slot and its
#       payload, and MEM is only filled from an EX slot EX accepted (valid, not
#       stalled, legal).  With P1/P2 this is "no record for a flushed/
#       never-retired instruction" and "rvfi_valid only with a legitimately
#       retired instruction";
#   P3b commit-path control invariant: no instruction is decoded as both a load
#       and a store (at the decoder output and through the pipeline registers),
#       which makes a record exactly one direction and the mask discipline hold;
#   P4  the trace ordinal advances exactly once per record (stated relationally,
#       so it is inductive at unbounded depth; it starts at 1 after reset, which
#       the base case covers): one record per retired instruction, in order;
#   P5  the recorded memory access is the D-port transfer that happened: the
#       request was driven AND accepted, the write mask is the bus value, the
#       masks are legal byte-lane runs of the addressed 8-byte beat, and the
#       store bytes on the bus equal the unshifted stored value the trace
#       reports. Since Sv39 (E2-RV2 increment 1) the trace reports the VIRTUAL
#       address (what Spike logs) while the bus carries the physical one, so the
#       tie is stated as `rvfi_mem_paddr_o == $past(dmem_addr_o)` — the physical
#       address of the committed access — plus "the page offset is shared", and
#       both hold with translation on and off;
#   P6  D-port write discipline: no write with a zero mask, the write mask is a
#       subset of the addressed beat, and a read never writes;
#   P7  a record never reports an architectural write to x0;
#
#   P8  a port ERROR RESPONSE is an access fault and never a retirement: a D-port
#       beat answered with `dmem_err_i` produces no trace record and is reported
#       with mcause 5/7 and mtval = the VIRTUAL address the instruction named
#       (`mem_addr_r`), and a fetch answered with `imem_err_i` never enters MEM at
#       all and is reported with mcause 1 (or 12, when the fetch's own
#       translation faulted) at its own pc. Stated over the free port environment, this is the "no silent
#       success on an unmapped or rejected access" half of the port contract that
#       the `cor_fault` corpus program drives end to end.
#
# Every property is a transition relation over (previous state, current state,
# inputs) plus one-cycle `$past` lookbacks on registered signals, so the proof
# holds by k-induction at unbounded depth — there is no harness length bound and
# no property-only counting state.  The I/D port environment is left free on
# purpose: the trace discipline must hold for any compliant memory behaviour, so
# assuming a slave contract here would weaken exactly the claim the DiffTest
# depends on.  Liveness (the core always retires something) is out of scope.
#
# The cover task witnesses retirements (with and without a register write, loads,
# stores, a full-beat store), both trap classes of the pre-increment set, a
# mispredict redirect, a stalled D-port access, the three access faults (a D-port
# error beat, a load fault, a store fault, a faulted fetch), and — since E2-RV2
# increment 1 — a walker PTE read, a translation fault on both the fetch and the
# data path, and a translated memory record, so the safety proof is non-vacuous.
#
#   P9  the D port has exactly one client: the page-table walker and the MEM
#       stage never drive it in the same cycle (`!(mmu_pte_req && dmem_req_core)`),
#       which is what keeps a translated store's address/data/write-enable intact
#       — without it the mux would hand the port to the walker and a store would
#       silently become a read;
#   P10 a walk result is only accepted for the address it was started for: a
#       completed fetch walk leaves `ft_valid_r` set only while `fw_vaddr_r` is
#       still the current `fetch_pc_r`, so a speculative walk cannot hand its page
#       to a pc the redirect has already moved to.
#
# Run:  sby -f ethereal-shell/formal/eth_rv_core.sby     (picked up by `make formal`)
[tasks]
prove
cover

[options]
# The properties are one-step relations plus a four-stage propagation chain
# (decoder -> ID -> EX -> MEM -> WB), so k-induction settles them well inside
# this depth; 24 cycles of cover depth give the covers room to reach the deeper
# scenarios (a run of retirements, both trap classes) from reset.
prove: mode prove
prove: depth 16
cover: mode cover
cover: depth 24

[engines]
prove: smtbmc
cover: smtbmc

[script]
read -formal eth_rv_pkg.sv
read -formal cor_alu.sv
read -formal cor_muldiv.sv
read -formal cor_lsu.sv
read -formal cor_regfile.sv
read -formal cor_decoder.sv
read -formal cor_mmu.sv
# F/D (E2-RV2 increment 2): the FP register file and the FPU the core now
# instantiates — without them the design cannot elaborate.
read -formal cor_fp_regfile.sv
read -formal cor_fpu.sv
read -formal eth_rv_core.sv
prep -top eth_rv_core

[files]
ethereal-shell/rtl/eth_rv/eth_rv_pkg.sv
ethereal-shell/rtl/eth_rv/cor_alu.sv
ethereal-shell/rtl/eth_rv/cor_muldiv.sv
ethereal-shell/rtl/eth_rv/cor_lsu.sv
ethereal-shell/rtl/eth_rv/cor_regfile.sv
ethereal-shell/rtl/eth_rv/cor_decoder.sv
ethereal-shell/rtl/eth_rv/cor_mmu.sv
ethereal-shell/rtl/eth_rv/cor_fp_regfile.sv
ethereal-shell/rtl/eth_rv/cor_fpu.sv
ethereal-shell/rtl/eth_rv/eth_rv_core.sv
