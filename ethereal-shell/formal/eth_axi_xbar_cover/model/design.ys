# running in ethereal-shell/formal/eth_axi_xbar_cover/src/
read -formal eth_axi_skidbuf.sv
read -formal eth_axi_xbar.sv
chparam -set N_MST 2 -set N_SLV 2 -set ADDR_MAP 128'hFFFFFF00FFFFFF000000010000000000 eth_axi_xbar
prep -top eth_axi_xbar

hierarchy -smtcheck
rename -witness
write_jny -no-connections ../model/design.json
write_rtlil ../model/design.il
